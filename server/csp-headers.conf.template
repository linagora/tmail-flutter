# 'unsafe-inline' remains because the mail viewer and composer inject scripts into srcdoc iframes, which inherit this policy.
# CSP_FRAME_ANCESTORS, CSP_FRAME_SRC, CSP_SCRIPT_SRC, CSP_CONNECT_SRC and CSP_IMG_SRC are rendered at container start when /etc/nginx is writable (see Dockerfile / README).
# CSP_REPORT_URI, when set, is added as report-uri on the report-only header by docker-entrypoint.d/25-csp-report-uri.sh.
add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' ${CSP_SCRIPT_SRC}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: ${CSP_IMG_SRC}; font-src 'self' data:; connect-src 'self' blob: https: wss: ${CSP_CONNECT_SRC}; frame-src 'self' blob: about: ${CSP_FRAME_SRC}; worker-src 'self' blob:; frame-ancestors ${CSP_FRAME_ANCESTORS}; object-src 'none'; base-uri 'self'; form-action 'none'" always;
add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' ${CSP_SCRIPT_SRC}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: ${CSP_IMG_SRC}; font-src 'self' data:; connect-src 'self' blob: https: wss: ${CSP_CONNECT_SRC}; frame-src 'self' blob: about: ${CSP_FRAME_SRC}; worker-src 'self' blob:; frame-ancestors ${CSP_FRAME_ANCESTORS}; object-src 'none'; base-uri 'self'; form-action 'none'" always;
