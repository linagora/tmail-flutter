pipeline {
    agent {
        label 'mobile'
    }

    options {
        timeout(time: 180, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        FLUTTER_VERSION = '3.38.9'
        FIREBASE_PROJECT_ID = 'twake-195010'
        RESULTS_BUCKET="flutter-test-results"
    }

    stages {
        stage('Prebuild') {
            steps {
                sh './scripts/prebuild.sh'
            }
        }

        stage('Run Patrol Mobile Integration Tests') {
            steps {
                withCredentials([file(credentialsId: 'firebase-testlab-sa', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                    // One Patrol job per agent: the backend container, ports and /tmp logs are host-wide.
                    sh 'flock -o /tmp/tmail-patrol-backend.lock ./scripts/patrol-integration-test-with-docker.sh'
                }
            }
        }
    }

    post {
        always {
            script {
                echo 'Running post-build cleanup...'

                echo 'Archiving Firebase Test Lab results...'
                archiveArtifacts artifacts: 'ftl-results/**, ci-logs/**', allowEmptyArchive: true, fingerprint: true
                junit testResults: 'ftl-results/**/test_result_*.xml', allowEmptyResults: true

                // Tear down the backend Docker stack if it is still running and belongs to this workspace.
                sh '''
                    flock -o /tmp/tmail-patrol-backend.lock bash -c '
                        cd backend-docker || exit 0
                        owner=$(docker inspect tmail-backend --format "{{ index .Config.Labels \\"com.docker.compose.project.working_dir\\" }}" 2>/dev/null || true)
                        if [ -n "$owner" ] && [ "$(realpath "$owner" 2>/dev/null)" = "$(pwd -P)" ]; then
                            docker compose down --remove-orphans 2>/dev/null || true
                        else
                            echo "tmail-backend not owned by this workspace (${owner:-none}); skip teardown."
                        fi
                    ' || true
                '''
            }
            deleteDir() /* clean up our workspace */
        }
        failure {
            echo 'Pipeline failed. Review the console log for details.'
        }
    }
}
